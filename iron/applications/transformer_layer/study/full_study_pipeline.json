  "thermal_recovery": {
    "enabled": true,
    "skip_in_smoke": true,
    "temperature_sensor_name": "k10temp",
    "temperature_sensor_input": "temp1_input",
    "recovery_tolerance_fraction": 0.05,
    "recovery_timeout_sec": 15.0,
    "recovery_poll_interval_sec": 1.0
