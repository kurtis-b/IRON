# Copy this file to /etc/transformer-layer-power-cycle.env and edit it for the
# actual power controller on your bench machine.

# Option 1: one command that performs the entire cycle.
# POWER_CYCLE_COMMAND="ipmitool chassis power cycle"

# Option 2: explicit off/on sequence.
POWER_OFF_COMMAND="echo 'replace me with the real power-off command'"
POWER_ON_COMMAND="echo 'replace me with the real power-on command'"
POWER_OFF_WAIT_SEC=2
POWER_ON_WAIT_SEC=5
