[Unit]
Description=Transformer layer benchmark power-cycle helper
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=TRANSFORMER_LAYER_POWER_CYCLE_ENV=/etc/transformer-layer-power-cycle.env
ExecStart=/usr/bin/env bash /home/cj/iron/iron/applications/transformer_layer/systemd/transformer-layer-power-cycle.sh
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
